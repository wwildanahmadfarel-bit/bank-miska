# Salin ke .env.local lalu isi nilai asli. JANGAN commit .env.local.
# Lokal (XAMPP/Laragon):
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=db_ukkcashless
DB_SSL=false
DB_POOL=3
DB_TIMEZONE=+07:00

# Cloud (Aiven MySQL, wajib SSL):
# DB_HOST=xxx.aivencloud.com
# DB_PORT=12345
# DB_USER=avnadmin
# DB_PASS=<password-aiven>
# DB_NAME=db_ukkcashless
# DB_SSL=true
# DB_POOL=1
# DB_TIMEZONE=+07:00
# Opsional: CA Aiven dalam base64 (satu baris) agar sertifikat diverifikasi.
# DB_SSL_CA=

# Wajib production: minimal 32 karakter acak.
# Buat: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Zona waktu aplikasi (tanggal & DATETIME).
APP_TIMEZONE=Asia/Jakarta

# Hanya untuk seed lokal / db:seed-prod. Jangan dimasukkan ke Vercel.
SEED_ADMIN_PASSWORD=
SEED_TELLER_PASSWORD=
SEED_SISWA_PASSWORD=
